        <item name="windowSplashScreenIconBackgroundColor">@color/launcher_end</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ShoppingList</item>
    </style>
</resources>
